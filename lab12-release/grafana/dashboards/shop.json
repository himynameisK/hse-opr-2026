{
  "uid": "shop", "title": "Магазин: техническое состояние", "schemaVersion": 40,
  "version": 1, "refresh": "5s", "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id":1,"type":"timeseries","title":"Запросы в секунду по версии","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by (release) (rate(shop_requests_total[1m]))","legendFormat":"{{release}}","refId":"A"}]},
    {"id":2,"type":"timeseries","title":"HTTP 5xx / все попытки, %","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * (sum by (release) (rate(shop_requests_total{status=\"503\"}[1m])) or (0 * sum by (release) (rate(shop_requests_total[1m])))) / sum by (release) (rate(shop_requests_total[1m]))","legendFormat":"{{release}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id":3,"type":"timeseries","title":"p95 обработки checkout, секунды","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, release) (rate(shop_duration_seconds_bucket[1m])))","legendFormat":"{{release}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s","min":0}}},
    {"id":4,"type":"timeseries","title":"Активный релиз (1, 2, 3)","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"shop_release","legendFormat":"release","refId":"A"}],"fieldConfig":{"defaults":{"min":0,"max":4,"decimals":0}}}
  ]
}
